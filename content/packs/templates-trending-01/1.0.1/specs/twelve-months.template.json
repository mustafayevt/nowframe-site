{
  "$schema": "nowframe.template-spec/1",
  "id": "twelve-months",
  "name": "Twelve months",
  "description": "A year recap with no year on it: twelve clips, one per month, each with its month slammed in huge on a flat colour block that rotates through the gels, whips every quarter, a flash every third cut and a held December.",
  "category": "recap",
  "tags": ["beatsync", "recap", "photodump"],
  "pro": true,
  "canvas": "9:16",
  "bpm": 137.4,
  "flexible": false,
  "minAppBuild": 9,
  "accent": "rose",
  "look": {"filter": "nowframe.filter.snapshot", "amount": 30, "grain": 6},
  "music": {"track": "nowframe.music.art-flower-art-flower-dancing-bee", "start": "preview", "gain": 1.0, "fadeOut": 0.6},
  "cover": {"from": "render", "background": "ink", "title": "Twelve months", "kicker": "One clip a month"},
  "sections": [
    { "id": "months", "slots": [
        {"id": "january", "label": "January", "beats": 2, "min": 0.48, "max": 1.75, "sample": "nature", "motion": "punch"},
        {"id": "february", "label": "February", "beats": 2, "min": 0.48, "max": 1.75, "sample": "home", "motion": "push"},
        {"id": "march", "label": "March", "beats": 2, "min": 0.48, "max": 1.75, "sample": "city", "motion": "punch", "cut": {"transition": "nowframe.transition.whip-pan", "beats": 0.5}},
        {"id": "april", "label": "April", "beats": 2, "min": 0.48, "max": 1.75, "sample": "nature", "motion": "push"},
        {"id": "may", "label": "May", "beats": 2, "min": 0.48, "max": 1.75, "sample": "food", "motion": "punch"},
        {"id": "june", "label": "June", "beats": 2, "min": 0.48, "max": 1.75, "sample": "water", "motion": "push", "cut": {"transition": "nowframe.transition.whip-pan", "beats": 0.5}},
        {"id": "july", "label": "July", "beats": 2, "min": 0.48, "max": 1.75, "sample": "travel", "motion": "punch"},
        {"id": "august", "label": "August", "beats": 2, "min": 0.48, "max": 1.75, "sample": "water", "motion": "push"},
        {"id": "september", "label": "September", "beats": 2, "min": 0.48, "max": 1.75, "sample": "city", "motion": "punch", "cut": {"transition": "nowframe.transition.whip-pan", "beats": 0.5}},
        {"id": "october", "label": "October", "beats": 2, "min": 0.48, "max": 1.75, "sample": "texture", "motion": "push"},
        {"id": "november", "label": "November", "beats": 2, "min": 0.48, "max": 1.75, "sample": "night", "motion": "punch"},
        {"id": "december", "label": "December", "beats": 4, "min": 0.96, "max": 3.5, "hold": true, "sample": "night", "motion": "pull"}
      ] }
  ],
  "beatEffects": [
    {"effect": "flash", "anchor": "cut", "every": 3, "offset": 2, "seconds": 0.1, "section": "months"},
    {"effect": "zoompulse", "anchor": "beat", "every": 2, "offset": 1, "seconds": 0.15, "section": "months"}
  ],
  "texts": [
    {"text": "JAN", "style": "number.huge", "animation": "slam", "inSeconds": 0.2, "outSeconds": 0.1, "size": 170, "color": "ink", "chip": "tungsten", "slot": "january", "y": -0.2},
    {"chip": "ink", "text": "12 CLIPS, 1 YEAR", "label": "Kicker", "style": "kicker.mono", "size": 36, "animation": "typewriter", "slot": "january", "through": "february", "y": -0.06},
    {"text": "FEB", "style": "number.huge", "animation": "slam", "inSeconds": 0.2, "outSeconds": 0.1, "size": 170, "color": "ink", "chip": "moss", "slot": "february", "y": -0.2},
    {"text": "MAR", "style": "number.huge", "animation": "slam", "inSeconds": 0.2, "outSeconds": 0.1, "size": 170, "color": "ink", "chip": "iris", "slot": "march", "y": -0.2},
    {"text": "APR", "style": "number.huge", "animation": "slam", "inSeconds": 0.2, "outSeconds": 0.1, "size": 170, "color": "ink", "chip": "rose", "slot": "april", "y": -0.2},
    {"text": "MAY", "style": "number.huge", "animation": "slam", "inSeconds": 0.2, "outSeconds": 0.1, "size": 170, "color": "ink", "chip": "sky", "slot": "may", "y": -0.2},
    {"text": "JUN", "style": "number.huge", "animation": "slam", "inSeconds": 0.2, "outSeconds": 0.1, "size": 170, "color": "ink", "chip": "tungsten", "slot": "june", "y": -0.2},
    {"text": "JUL", "style": "number.huge", "animation": "slam", "inSeconds": 0.2, "outSeconds": 0.1, "size": 170, "color": "ink", "chip": "moss", "slot": "july", "y": -0.2},
    {"text": "AUG", "style": "number.huge", "animation": "slam", "inSeconds": 0.2, "outSeconds": 0.1, "size": 170, "color": "ink", "chip": "iris", "slot": "august", "y": -0.2},
    {"text": "SEP", "style": "number.huge", "animation": "slam", "inSeconds": 0.2, "outSeconds": 0.1, "size": 170, "color": "ink", "chip": "rose", "slot": "september", "y": -0.2},
    {"text": "OCT", "style": "number.huge", "animation": "slam", "inSeconds": 0.2, "outSeconds": 0.1, "size": 170, "color": "ink", "chip": "sky", "slot": "october", "y": -0.2},
    {"text": "NOV", "style": "number.huge", "animation": "slam", "inSeconds": 0.2, "outSeconds": 0.1, "size": 170, "color": "ink", "chip": "tungsten", "slot": "november", "y": -0.2},
    {"text": "DEC", "style": "number.huge", "animation": "slam", "inSeconds": 0.2, "outSeconds": 0.1, "size": 170, "color": "ink", "chip": "moss", "slot": "december", "beats": 3, "y": -0.2},
    {"chip": "ink", "text": "SEE YOU NEXT YEAR", "label": "Sign-off", "style": "kicker.mono", "size": 36, "animation": "typewriter", "slot": "december", "at": 1, "beats": 3, "y": -0.06}
  ],
  "sounds": [
    {"sound": "nowframe.sound.whoosh", "slot": "april", "at": 0, "gain": 0.3},
    {"sound": "nowframe.sound.whoosh", "slot": "july", "at": 0, "gain": 0.3},
    {"sound": "nowframe.sound.whoosh", "slot": "october", "at": 0, "gain": 0.3}
  ]
}
