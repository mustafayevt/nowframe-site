{
  "$schema": "nowframe.template-spec/1",
  "id": "week-by-week",
  "name": "Week by week",
  "description": "A progress reveal for a garden, a plant, a build or a sourdough starter: five stages from the same angle with clock wipes and huge week numbers that hit on the beat, a flash into the finished result.",
  "category": "makeover",
  "tags": ["beatsync"],
  "pro": true,
  "canvas": "9:16",
  "bpm": 104.3,
  "flexible": false,
  "minAppBuild": 9,
  "accent": "moss",
  "look": {"filter": "nowframe.filter.porcelain", "amount": 30, "grain": 4},
  "music": {"track": "nowframe.music.amarent-stairwell-harmony", "start": "preview", "gain": 1.0, "fadeOut": 0.6},
  "cover": {"from": "render", "background": "ink", "title": "Week by week", "kicker": "Progress"},
  "sections": [
    { "id": "progress", "slots": [
        {"id": "stage-1", "label": "Start", "beats": 2, "min": 0.63, "max": 2.31, "sample": "nature", "motion": "still", "cut": {"transition": "nowframe.transition.clock-wipe", "beats": 0.5}},
        {"id": "stage-2", "label": "Week 2", "beats": 2, "min": 0.63, "max": 2.31, "sample": "home", "motion": "still", "cut": {"transition": "nowframe.transition.clock-wipe", "beats": 0.5}},
        {"id": "stage-3", "label": "Week 4", "beats": 2, "min": 0.63, "max": 2.31, "sample": "nature", "motion": "still", "cut": {"transition": "nowframe.transition.clock-wipe", "beats": 0.5}},
        {"id": "stage-4", "label": "Week 6", "beats": 2, "min": 0.63, "max": 2.31, "sample": "home", "motion": "still", "cut": {"transition": "nowframe.transition.clock-wipe", "beats": 0.5}},
        {"id": "stage-5", "label": "Week 8", "beats": 2, "min": 0.63, "max": 2.31, "sample": "nature", "motion": "still", "cut": {"transition": "nowframe.transition.flash", "beats": 0.25}},
        {"id": "reveal", "label": "Reveal", "beats": 4, "min": 1.26, "max": 4.61, "sample": "nature", "motion": "punch"},
        {"id": "detail-1", "label": "Detail 1", "beats": 1, "min": 0.31, "max": 1.2, "sample": "home", "motion": "punch"},
        {"id": "detail-2", "label": "Detail 2", "beats": 1, "min": 0.31, "max": 1.2, "sample": "nature", "motion": "push"},
        {"id": "final", "label": "Final", "beats": 3, "min": 0.94, "max": 3.46, "hold": true, "sample": "home", "motion": "pull"}
      ] }
  ],
  "beatEffects": [
    {"effect": "zoompulse", "anchor": "beat", "every": 2, "offset": 1, "seconds": 0.15, "from": "reveal", "through": "detail-2"}
  ],
  "texts": [
    {"chip": "ink", "text": "WEEK", "style": "kicker.mono", "size": 36, "animation": "fade", "slot": "stage-1", "through": "stage-5", "y": -0.3},
    {"text": "1", "color": "ink", "chip": "tungsten", "style": "number.huge", "animation": "slam", "inSeconds": 0.2, "outSeconds": 0.1, "slot": "stage-1", "y": -0.2},
    {"text": "2", "color": "ink", "chip": "tungsten", "style": "number.huge", "animation": "slam", "inSeconds": 0.2, "outSeconds": 0.1, "slot": "stage-2", "y": -0.2},
    {"text": "4", "color": "ink", "chip": "tungsten", "style": "number.huge", "animation": "slam", "inSeconds": 0.2, "outSeconds": 0.1, "slot": "stage-3", "y": -0.2},
    {"text": "6", "color": "ink", "chip": "tungsten", "style": "number.huge", "animation": "slam", "inSeconds": 0.2, "outSeconds": 0.1, "slot": "stage-4", "y": -0.2},
    {"text": "8", "color": "ink", "chip": "tungsten", "style": "number.huge", "animation": "slam", "inSeconds": 0.2, "outSeconds": 0.1, "slot": "stage-5", "y": -0.2},
    {"chip": "ink", "text": "12 WEEKS LATER", "label": "Time passed", "style": "kicker.mono", "size": 36, "animation": "typewriter", "slot": "reveal", "beats": 2, "y": -0.3},
    {"text": "Finished", "label": "Reveal", "style": "title.big", "animation": "slam", "slot": "reveal", "at": 0.5, "beats": 3.5, "y": -0.21},
    {"chip": "ink", "text": "Slow and steady", "label": "Sign-off", "style": "quote.serif", "size": 60, "animation": "reveal", "slot": "final", "at": 0.5, "y": 0.16}
  ],
  "sounds": [
    {"sound": "nowframe.sound.pop", "slot": "stage-1", "at": 0, "gain": 0.3},
    {"sound": "nowframe.sound.pop", "slot": "stage-2", "at": 0, "gain": 0.3},
    {"sound": "nowframe.sound.pop", "slot": "stage-3", "at": 0, "gain": 0.3},
    {"sound": "nowframe.sound.pop", "slot": "stage-4", "at": 0, "gain": 0.3},
    {"sound": "nowframe.sound.pop", "slot": "stage-5", "at": 0, "gain": 0.3},
    {"sound": "nowframe.sound.sparkle", "slot": "reveal", "at": 0, "gain": 0.35}
  ]
}
