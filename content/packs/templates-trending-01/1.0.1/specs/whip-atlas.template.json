{
  "$schema": "nowframe.template-spec/1",
  "id": "whip-atlas",
  "name": "Whip atlas",
  "description": "A multi-city travel edit where every cut is a whip on the beat: a speed-burst arrival, eight two-beat shots with alternating whips and zoom blurs, each city slammed in left or right with its coordinates typed under it.",
  "category": "travel",
  "tags": ["beatsync", "travel"],
  "pro": true,
  "canvas": "9:16",
  "bpm": 115.3,
  "flexible": false,
  "minAppBuild": 9,
  "accent": "sky",
  "look": {"filter": "nowframe.filter.coast", "amount": 35, "grain": 4},
  "music": {"track": "nowframe.music.holiznacc0-love-love-love", "start": "preview", "gain": 1.0, "fadeOut": 0.6},
  "cover": {"from": "render", "background": "ink", "title": "Whip atlas", "kicker": "Four cities"},
  "sections": [
    { "id": "trip", "slots": [
        {"id": "arrival", "label": "Arrival", "beats": 4, "min": 1.14, "max": 4.17, "keepsSpeed": true, "speed": "nowframe.speed.burstIn", "sample": "travel", "prefers": "video", "motion": "punch", "cut": {"transition": "nowframe.transition.quick-whip", "beats": 0.5}},
        {"id": "place-1", "label": "Place 1", "beats": 2, "min": 0.57, "max": 2.09, "sample": "city", "motion": "punch", "cut": {"transition": "nowframe.transition.whip-pan", "beats": 0.5}},
        {"id": "place-2", "label": "Place 2", "beats": 2, "min": 0.57, "max": 2.09, "sample": "travel", "motion": "push", "cut": {"transition": "nowframe.transition.quick-whip", "beats": 0.5}},
        {"id": "place-3", "label": "Place 3", "beats": 2, "min": 0.57, "max": 2.09, "sample": "night", "motion": "punch", "cut": {"transition": "nowframe.transition.zoom-blur", "beats": 0.5}},
        {"id": "place-4", "label": "Place 4", "beats": 2, "min": 0.57, "max": 2.09, "sample": "city", "motion": "push", "cut": {"transition": "nowframe.transition.whip-pan", "beats": 0.5}},
        {"id": "place-5", "label": "Place 5", "beats": 2, "min": 0.57, "max": 2.09, "sample": "nature", "motion": "punch", "cut": {"transition": "nowframe.transition.quick-whip", "beats": 0.5}},
        {"id": "place-6", "label": "Place 6", "beats": 2, "min": 0.57, "max": 2.09, "sample": "travel", "motion": "push", "cut": {"transition": "nowframe.transition.whip-pan", "beats": 0.5}},
        {"id": "place-7", "label": "Place 7", "beats": 2, "min": 0.57, "max": 2.09, "sample": "water", "motion": "punch", "cut": {"transition": "nowframe.transition.zoom-blur", "beats": 0.5}},
        {"id": "place-8", "label": "Place 8", "beats": 2, "min": 0.57, "max": 2.09, "sample": "city", "motion": "push"},
        {"id": "last-view", "label": "Last view", "beats": 4, "min": 1.14, "max": 4.17, "hold": true, "sample": "nature", "motion": "pull"}
      ] }
  ],
  "beatEffects": [
    {"effect": "zoompulse", "anchor": "beat", "every": 2, "offset": 1, "seconds": 0.18, "from": "place-1", "through": "place-8"}
  ],
  "texts": [
    {"chip": "ink", "text": "ONE BIG TRIP", "label": "Kicker", "style": "kicker.mono", "size": 36, "animation": "typewriter", "slot": "arrival", "at": 0.5, "beats": 3.5, "y": -0.31},
    {"chip": "ink", "text": "FAR FROM\nHOME", "label": "Title", "style": "title.big", "animation": "slam", "slot": "arrival", "at": 1, "beats": 3, "y": -0.2},
    {"chip": "ink", "text": "First stop", "label": "City 1", "style": "title.big", "animation": "slam", "size": 92, "slot": "place-1", "through": "place-2", "x": -0.14, "y": -0.26},
    {"chip": "ink", "text": "STOP 01", "label": "Coordinates 1", "style": "kicker.mono", "size": 36, "animation": "typewriter", "slot": "place-1", "at": 0.5, "through": "place-2", "x": -0.14, "y": -0.185},
    {"chip": "ink", "text": "Next stop", "label": "City 2", "style": "title.big", "animation": "slam", "size": 92, "slot": "place-3", "through": "place-4", "x": 0.14, "y": -0.26},
    {"chip": "ink", "text": "STOP 02", "label": "Coordinates 2", "style": "kicker.mono", "size": 36, "animation": "typewriter", "slot": "place-3", "at": 0.5, "through": "place-4", "x": 0.14, "y": -0.185},
    {"chip": "ink", "text": "Then here", "label": "City 3", "style": "title.big", "animation": "slam", "size": 92, "slot": "place-5", "through": "place-6", "x": -0.14, "y": -0.26},
    {"chip": "ink", "text": "STOP 03", "label": "Coordinates 3", "style": "kicker.mono", "size": 36, "animation": "typewriter", "slot": "place-5", "at": 0.5, "through": "place-6", "x": -0.14, "y": -0.185},
    {"chip": "ink", "text": "Last stop", "label": "City 4", "style": "title.big", "animation": "slam", "size": 92, "slot": "place-7", "through": "place-8", "x": 0.14, "y": -0.26},
    {"chip": "ink", "text": "STOP 04", "label": "Coordinates 4", "style": "kicker.mono", "size": 36, "animation": "typewriter", "slot": "place-7", "at": 0.5, "through": "place-8", "x": 0.14, "y": -0.185},
    {"chip": "ink", "text": "Planning the next one", "label": "Sign-off", "style": "caption.medium", "animation": "words", "slot": "last-view", "at": 0.5, "y": 0.16}
  ],
  "sounds": [
    {"sound": "nowframe.sound.whoosh", "slot": "place-1", "at": 0, "gain": 0.3},
    {"sound": "nowframe.sound.whoosh", "slot": "place-3", "at": 0, "gain": 0.3},
    {"sound": "nowframe.sound.whoosh", "slot": "place-5", "at": 0, "gain": 0.3},
    {"sound": "nowframe.sound.whoosh", "slot": "place-7", "at": 0, "gain": 0.3}
  ]
}
