{
  "$schema": "nowframe.template-spec/1",
  "id": "month-in-lines",
  "name": "Month in four lines",
  "description": "A text-led recap: a title card, then four moments of the month, each with one line that types in word by word and a numbered chip, and a sign-off.",
  "category": "text",
  "tags": ["beatsync", "recap", "text"],
  "pro": false,
  "canvas": "9:16",
  "bpm": 96,
  "flexible": false,
  "minAppBuild": 9,
  "accent": "iris",
  "look": { "filter": "nowframe.filter.film-fade", "amount": 30, "grain": 6 },
  "music": { "track": "nowframe.music.holiznacc0-waiting-around", "start": "preview", "gain": 0.9, "fadeOut": 0.8 },
  "cover": { "from": "render", "background": "paper", "title": "Month in four lines", "kicker": "A text recap" },
  "sections": [
    {
      "id": "title",
      "slots": [
        { "id": "title-card", "card": "paper", "beats": 4 }
      ]
    },
    {
      "id": "lines",
      "cut": { "transition": "nowframe.transition.push", "beats": 0.5 },
      "slots": [
        { "id": "moment-1", "label": "Moment 1", "beats": 4, "min": 1.6, "max": 4, "sample": "home", "motion": "push" },
        { "id": "moment-2", "label": "Moment 2", "beats": 4, "min": 1.6, "max": 4, "sample": "sport", "motion": "right" },
        { "id": "moment-3", "label": "Moment 3", "beats": 4, "min": 1.6, "max": 4, "sample": "food", "motion": "pull" },
        { "id": "moment-4", "label": "Moment 4", "beats": 4, "min": 1.6, "max": 4, "sample": "water", "motion": "left",
          "cut": { "transition": "nowframe.transition.dissolve", "beats": 1 } }
      ]
    },
    {
      "id": "end",
      "slots": [
        { "id": "last-frame", "label": "Last frame", "beats": 4, "hold": true, "sample": "night", "motion": "pull" }
      ]
    }
  ],
  "texts": [
    { "text": "November,\nrecapped", "label": "Title", "style": "title.ink", "animation": "reveal", "slot": "title-card",
      "at": 0.25, "beats": 3.75, "y": -0.04 },
    { "text": "IN FOUR LINES", "label": "Subtitle", "style": "kicker.mono", "size": 36, "color": "slate", "animation": "fade",
      "slot": "title-card", "at": 1, "beats": 3, "y": 0.06 },
    { "text": "01", "style": "label.gel", "size": 36, "animation": "typewriter", "slot": "moment-1", "at": 0, "y": 0.1 },
    { "text": "Moved into a new place", "label": "Line 1", "style": "caption.chip", "animation": "words", "slot": "moment-1",
      "at": 0.5, "y": 0.18 },
    { "text": "02", "style": "label.gel", "size": 36, "animation": "typewriter", "slot": "moment-2", "at": 0, "y": 0.1 },
    { "text": "Got moving again", "label": "Line 2", "style": "caption.chip", "animation": "words", "slot": "moment-2",
      "at": 0.5, "y": 0.18 },
    { "text": "03", "style": "label.gel", "size": 36, "animation": "typewriter", "slot": "moment-3", "at": 0, "y": 0.1 },
    { "text": "Tried something new", "label": "Line 3", "style": "caption.chip", "animation": "words", "slot": "moment-3",
      "at": 0.5, "y": 0.18 },
    { "text": "04", "style": "label.gel", "size": 36, "animation": "typewriter", "slot": "moment-4", "at": 0, "y": 0.1 },
    { "text": "Saw the sea twice", "label": "Line 4", "style": "caption.chip", "animation": "words", "slot": "moment-4",
      "at": 0.5, "y": 0.18 },
    { "text": "Here's to December", "label": "Sign-off", "style": "quote.serif", "animation": "reveal", "slot": "last-frame",
      "at": 0.5, "y": 0.16 }
  ],
  "shapes": [
    { "shape": "ellipse", "color": "tally", "slot": "title-card", "at": 0.25, "beats": 3.75, "x": 0, "y": -0.14, "scale": 0.045 }
  ]
}
