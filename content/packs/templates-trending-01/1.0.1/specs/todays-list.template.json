{
  "$schema": "nowframe.template-spec/1",
  "id": "todays-list",
  "name": "Today's list",
  "description": "A checklist that writes itself: a slammed header, then five errands, each one skids onto a growing list with a pop as its clip plays, whips between errands, and 'all done' over the last shot.",
  "category": "vlog",
  "tags": ["beatsync", "vlog", "text"],
  "pro": true,
  "canvas": "9:16",
  "bpm": 119.8,
  "flexible": false,
  "minAppBuild": 9,
  "accent": "moss",
  "look": {"filter": "nowframe.filter.peach", "amount": 30, "grain": 6},
  "music": {"track": "nowframe.music.loyalty-freak-music-after-party", "start": "preview", "gain": 1.0, "fadeOut": 0.6},
  "cover": {"from": "render", "background": "ink", "title": "Today's list", "kicker": "Five things today"},
  "sections": [
    { "id": "day", "slots": [
        {"id": "opener", "label": "Opener", "beats": 5, "min": 1.37, "max": 5.01, "sample": "city", "motion": "push"},
        {"id": "item-1", "label": "Item 1", "beats": 2, "min": 0.55, "max": 2.01, "sample": "food", "motion": "punch"},
        {"id": "detail-1", "label": "Item 1 detail", "beats": 1, "min": 0.3, "max": 1.2, "sample": "city", "motion": "push", "cut": {"transition": "nowframe.transition.quick-whip", "beats": 0.5}},
        {"id": "item-2", "label": "Item 2", "beats": 2, "min": 0.55, "max": 2.01, "sample": "nature", "motion": "punch"},
        {"id": "detail-2", "label": "Item 2 detail", "beats": 1, "min": 0.3, "max": 1.2, "sample": "home", "motion": "push", "cut": {"transition": "nowframe.transition.quick-whip", "beats": 0.5}},
        {"id": "item-3", "label": "Item 3", "beats": 2, "min": 0.55, "max": 2.01, "sample": "home", "motion": "punch"},
        {"id": "detail-3", "label": "Item 3 detail", "beats": 1, "min": 0.3, "max": 1.2, "sample": "texture", "motion": "push", "cut": {"transition": "nowframe.transition.quick-whip", "beats": 0.5}},
        {"id": "item-4", "label": "Item 4", "beats": 2, "min": 0.55, "max": 2.01, "sample": "nature", "motion": "punch"},
        {"id": "detail-4", "label": "Item 4 detail", "beats": 1, "min": 0.3, "max": 1.2, "sample": "water", "motion": "push", "cut": {"transition": "nowframe.transition.quick-whip", "beats": 0.5}},
        {"id": "item-5", "label": "Item 5", "beats": 2, "min": 0.55, "max": 2.01, "sample": "food", "motion": "punch"},
        {"id": "detail-5", "label": "Item 5 detail", "beats": 1, "min": 0.3, "max": 1.2, "sample": "home", "motion": "push"},
        {"id": "done", "label": "All done", "beats": 4, "min": 1.1, "max": 4.01, "hold": true, "sample": "night", "motion": "pull"}
      ] }
  ],
  "beatEffects": [
    {"effect": "zoompulse", "anchor": "beat", "every": 2, "seconds": 0.15, "from": "item-1", "through": "detail-5"}
  ],
  "texts": [
    {"text": "Today's list", "chip": "ink", "label": "Title", "style": "title.display", "animation": "slam", "size": 96, "slot": "opener", "at": 0.5, "through": "done", "y": -0.3},
    {"text": "01 COFFEE RUN", "label": "Item 1", "style": "label.chip", "size": 36, "animation": "slide-up", "in": "anim.in.skid", "inSeconds": 0.3, "slot": "item-1", "through": "done", "y": -0.2},
    {"text": "02 FLOWERS", "label": "Item 2", "style": "label.chip", "size": 36, "animation": "slide-up", "in": "anim.in.skid", "inSeconds": 0.3, "slot": "item-2", "through": "done", "y": -0.15},
    {"text": "03 BOOK SWAP", "label": "Item 3", "style": "label.chip", "size": 40, "animation": "slide-up", "in": "anim.in.skid", "inSeconds": 0.3, "slot": "item-3", "through": "done", "y": -0.09},
    {"text": "04 LONG WALK", "label": "Item 4", "style": "label.chip", "size": 40, "animation": "slide-up", "in": "anim.in.skid", "inSeconds": 0.3, "slot": "item-4", "through": "done", "y": -0.04},
    {"text": "05 DINNER", "label": "Item 5", "style": "label.chip", "size": 36, "animation": "slide-up", "in": "anim.in.skid", "inSeconds": 0.3, "slot": "item-5", "through": "done", "y": 0.02},
    {"text": "ALL DONE", "label": "Sign-off", "style": "label.gel", "size": 42, "animation": "slide-up", "slot": "done", "at": 0.5, "y": 0.11}
  ],
  "sounds": [
    {"sound": "nowframe.sound.pop", "slot": "item-1", "at": 0, "gain": 0.35},
    {"sound": "nowframe.sound.pop", "slot": "item-2", "at": 0, "gain": 0.35},
    {"sound": "nowframe.sound.pop", "slot": "item-3", "at": 0, "gain": 0.35},
    {"sound": "nowframe.sound.pop", "slot": "item-4", "at": 0, "gain": 0.35},
    {"sound": "nowframe.sound.pop", "slot": "item-5", "at": 0, "gain": 0.35}
  ]
}
