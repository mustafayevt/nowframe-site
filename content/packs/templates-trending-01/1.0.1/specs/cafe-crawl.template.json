{
  "$schema": "nowframe.template-spec/1",
  "id": "cafe-crawl",
  "name": "Cafe crawl",
  "description": "A square food crawl with scores: a slammed title, then three stops, each with a typed name chip, a detail cut and a huge score that punches in with a hit, and the winner over the last shot.",
  "category": "food",
  "tags": ["beatsync"],
  "pro": true,
  "canvas": "1:1",
  "bpm": 125,
  "flexible": false,
  "minAppBuild": 9,
  "accent": "rose",
  "look": {"filter": "nowframe.filter.bakery", "amount": 35, "grain": 8, "warmth": 6},
  "music": {"track": "nowframe.music.zane-little-empty-stretch", "start": "preview", "gain": 1.0, "fadeOut": 0.6},
  "cover": {"from": "render", "background": "ink", "title": "Cafe crawl", "kicker": "Three stops"},
  "sections": [
    { "id": "crawl", "slots": [
        {"id": "opener", "label": "Opener", "beats": 3, "min": 0.79, "max": 2.88, "sample": "food", "motion": "punch", "cut": {"transition": "nowframe.transition.zoom-blur", "beats": 0.75}},
        {"id": "stop-1", "label": "Stop 1", "beats": 3, "min": 0.79, "max": 2.88, "sample": "food", "motion": "push"},
        {"id": "stop-1-detail", "label": "Stop 1 detail", "beats": 2, "min": 0.52, "max": 1.92, "sample": "food", "motion": "punch"},
        {"id": "stop-1-score", "label": "Stop 1 score", "beats": 3, "min": 0.79, "max": 2.88, "sample": "food", "motion": "still", "cut": {"transition": "nowframe.transition.zoom-blur", "beats": 0.75}},
        {"id": "stop-2", "label": "Stop 2", "beats": 3, "min": 0.79, "max": 2.88, "sample": "food", "motion": "push"},
        {"id": "stop-2-detail", "label": "Stop 2 detail", "beats": 2, "min": 0.52, "max": 1.92, "sample": "food", "motion": "punch"},
        {"id": "stop-2-score", "label": "Stop 2 score", "beats": 3, "min": 0.79, "max": 2.88, "sample": "food", "motion": "still", "cut": {"transition": "nowframe.transition.zoom-blur", "beats": 0.75}},
        {"id": "stop-3", "label": "Stop 3", "beats": 3, "min": 0.79, "max": 2.88, "sample": "food", "motion": "push"},
        {"id": "stop-3-detail", "label": "Stop 3 detail", "beats": 2, "min": 0.52, "max": 1.92, "sample": "food", "motion": "punch"},
        {"id": "stop-3-score", "label": "Stop 3 score", "beats": 3, "min": 0.79, "max": 2.88, "sample": "food", "motion": "still"},
        {"id": "winner", "label": "Winner", "beats": 4, "min": 1.05, "max": 3.84, "hold": true, "sample": "food", "motion": "pull"}
      ] }
  ],
  "beatEffects": [
    {"effect": "zoompulse", "anchor": "beat", "every": 2, "offset": 1, "seconds": 0.15, "from": "stop-1", "through": "stop-3-score"}
  ],
  "texts": [
    {"text": "CAFE\nCRAWL", "label": "Title", "style": "title.big", "animation": "slam", "slot": "opener", "at": 0.5, "y": -0.12},
    {"chip": "ink", "text": "3 SPOTS, 1 WINNER", "label": "Kicker", "style": "kicker.mono", "size": 36, "animation": "typewriter", "slot": "opener", "at": 1, "y": 0.1},
    {"text": "01 FIRST SPOT", "label": "Stop 1 name", "style": "label.gel", "size": 36, "animation": "typewriter", "slot": "stop-1", "through": "stop-1-detail", "y": -0.28},
    {"text": "8/10", "label": "Score 1", "style": "number.huge", "animation": "slam", "slot": "stop-1-score", "y": -0.06},
    {"text": "02 NEXT SPOT", "label": "Stop 2 name", "style": "label.gel", "size": 36, "animation": "typewriter", "slot": "stop-2", "through": "stop-2-detail", "y": -0.28},
    {"text": "9/10", "label": "Score 2", "style": "number.huge", "animation": "slam", "slot": "stop-2-score", "y": -0.06},
    {"text": "03 LAST SPOT", "label": "Stop 3 name", "style": "label.gel", "size": 36, "animation": "typewriter", "slot": "stop-3", "through": "stop-3-detail", "y": -0.28},
    {"text": "7/10", "label": "Score 3", "style": "number.huge", "animation": "slam", "slot": "stop-3-score", "y": -0.06},
    {"text": "Spot 2 wins", "label": "Verdict", "style": "title.display", "animation": "slam", "slot": "winner", "at": 0.75, "y": -0.12}
  ],
  "sounds": [
    {"sound": "nowframe.sound.punch", "slot": "stop-1-score", "at": 0, "gain": 0.4},
    {"sound": "nowframe.sound.punch", "slot": "stop-2-score", "at": 0, "gain": 0.4},
    {"sound": "nowframe.sound.punch", "slot": "stop-3-score", "at": 0, "gain": 0.4},
    {"sound": "nowframe.sound.swoosh", "slot": "stop-2", "at": 0, "gain": 0.3},
    {"sound": "nowframe.sound.swoosh", "slot": "stop-3", "at": 0, "gain": 0.3}
  ]
}
