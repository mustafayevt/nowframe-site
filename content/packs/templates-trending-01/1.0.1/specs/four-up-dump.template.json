{
  "$schema": "nowframe.template-spec/1",
  "id": "four-up-dump",
  "name": "Four up",
  "description": "A photo dump four at a time: a title card that follows the tempo, three 2 x 2 grids that swap on the bar with a tick and a zoom pulse, and one full-screen favorite to end on.",
  "category": "photodump",
  "tags": ["beatsync", "photodump"],
  "pro": false,
  "canvas": "9:16",
  "bpm": 120,
  "flexible": false,
  "minAppBuild": 9,
  "accent": "tungsten",
  "look": {"filter": "nowframe.filter.vivid", "amount": 30, "grain": 6, "vignette": 35},
  "music": {"track": "nowframe.music.holiznacc0-pixel-party", "start": "preview", "gain": 1.0, "fadeOut": 0.6},
  "cover": {"from": "render", "frame": 3.2, "background": "ink", "title": "Four up", "kicker": "Photo dump"},
  "sections": [
    { "id": "title", "stretch": true, "slots": [
        {"id": "title-card", "card": "ink", "beats": 4}
      ] },
    { "id": "grids", "repeat": 3,
      "layout": {"kind": "grid", "beats": 4, "min": 1.2, "max": 4.4, "gap": 0.012, "color": "ink", "radius": 0.04},
      "slots": [
        {"label": "Photo {n}", "sample": "any", "prefers": "photo"},
        {"label": "Photo {n}", "sample": "nature", "prefers": "photo"},
        {"label": "Photo {n}", "sample": "water", "prefers": "photo"},
        {"label": "Photo {n}", "sample": "travel", "prefers": "photo"}
      ] },
    { "id": "favorite", "slots": [
        {"id": "favorite", "label": "Favorite", "beats": 4, "min": 1.2, "max": 4.4, "sample": "nature", "motion": "punch"}
      ] }
  ],
  "beatEffects": [
    {"effect": "zoompulse", "anchor": "cut", "seconds": 0.2, "section": "grids"},
    {"effect": "flash", "anchor": "cut", "seconds": 0.15, "from": "favorite", "through": "favorite"}
  ],
  "texts": [
    {"chip": "ink", "text": "PHOTO DUMP", "style": "kicker.mono", "size": 36, "animation": "typewriter", "anchor": "left", "inset": 0.09, "slot": "title-card", "y": -0.1},
    {"text": "This week", "label": "Title", "style": "title.big", "animation": "rise", "align": "left", "inset": 0.09, "slot": "title-card", "at": 0.5, "y": 0.0},
    {"text": "PART 1", "style": "label.chip", "size": 36, "animation": "cut", "slot": "photo-1", "at": 0.5, "beats": 3, "x": 0, "y": 0},
    {"text": "PART 2", "style": "label.chip", "size": 36, "animation": "cut", "slot": "photo-5", "at": 0.5, "beats": 3, "x": 0, "y": 0},
    {"text": "PART 3", "style": "label.chip", "size": 36, "animation": "cut", "slot": "photo-9", "at": 0.5, "beats": 3, "x": 0, "y": 0},
    {"text": "Best of the bunch", "label": "Sign-off", "style": "caption.chip", "animation": "words", "align": "right", "anchor": "right", "inset": 0.07, "slot": "favorite", "at": 1, "y": 0.2}
  ],
  "sounds": [
    {"sound": "nowframe.sound.tick", "slot": "photo-1", "gain": 0.6},
    {"sound": "nowframe.sound.tick", "slot": "photo-5", "gain": 0.6},
    {"sound": "nowframe.sound.tick", "slot": "photo-9", "gain": 0.6},
    {"sound": "nowframe.sound.drop", "slot": "favorite", "gain": 0.45}
  ]
}
