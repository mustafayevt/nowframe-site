{
  "$schema": "nowframe.template-spec/1",
  "id": "product-drop",
  "name": "Product drop",
  "description": "A launch teaser for a product: three dark one-beat close-ups with split hits under a typed line, an RGB smash into the hero with a slammed headline, three features on chips with punch-ins, the price and a call to action.",
  "category": "product",
  "tags": ["beatsync", "product"],
  "pro": true,
  "canvas": "9:16",
  "bpm": 79.9,
  "flexible": false,
  "minAppBuild": 9,
  "accent": "sky",
  "look": {"contrast": 10, "clarity": 15},
  "music": {"track": "nowframe.music.holiznacc0-serial", "start": "preview", "gain": 1.0, "fadeOut": 0.6},
  "cover": {"from": "render", "background": "ink", "title": "Product drop", "kicker": "Launch teaser"},
  "sections": [
    { "id": "launch", "slots": [
        {"id": "tease-1", "label": "Tease 1", "beats": 1, "min": 0.41, "max": 1.51, "sample": "product", "motion": "punch", "look": {"filter": "nowframe.filter.noir-blue", "amount": 60, "brightness": -4, "contrast": 20, "vignette": 40}},
        {"id": "tease-2", "label": "Tease 2", "beats": 1, "min": 0.41, "max": 1.51, "sample": "product", "motion": "punch", "zoom": 1.08, "look": {"filter": "nowframe.filter.noir-blue", "amount": 60, "brightness": -4, "contrast": 20, "vignette": 40}},
        {"id": "tease-3", "label": "Tease 3", "beats": 1, "min": 0.41, "max": 1.51, "sample": "product", "motion": "punch", "zoom": 1.16, "cut": {"transition": "nowframe.transition.rgb-smash", "beats": 0.5}, "look": {"filter": "nowframe.filter.noir-blue", "amount": 60, "brightness": -4, "contrast": 20, "vignette": 40}},
        {"id": "hero", "label": "Hero shot", "beats": 3, "min": 1.23, "max": 4.51, "sample": "product", "motion": "punch", "cut": {"transition": "nowframe.transition.zoom-blur", "beats": 0.5}},
        {"id": "feature-1", "label": "Feature 1", "beats": 2, "min": 0.82, "max": 3.01, "sample": "product", "motion": "push", "cut": {"transition": "nowframe.transition.flash", "beats": 0.5}},
        {"id": "feature-2", "label": "Feature 2", "beats": 2, "min": 0.82, "max": 3.01, "sample": "product", "motion": "left", "cut": {"transition": "nowframe.transition.flash", "beats": 0.5}},
        {"id": "feature-3", "label": "Feature 3", "beats": 2, "min": 0.82, "max": 3.01, "sample": "product", "motion": "right", "cut": {"transition": "nowframe.transition.flash", "beats": 0.25}},
        {"id": "end", "label": "End card", "beats": 3, "min": 1.23, "max": 4.51, "hold": true, "sample": "product", "motion": "pull"}
      ] }
  ],
  "beatEffects": [
    {"effect": "channelsplit", "anchor": "cut", "every": 1, "seconds": 0.15, "from": "tease-1", "through": "tease-3"},
    {"effect": "zoompulse", "anchor": "beat", "every": 2, "seconds": 0.15, "from": "feature-1", "through": "end"}
  ],
  "texts": [
    {"chip": "ink", "text": "SOMETHING NEW", "label": "Teaser", "style": "kicker.mono", "size": 36, "animation": "typewriter", "slot": "tease-1", "through": "tease-3", "y": -0.02},
    {"text": "NEW\nDROP", "label": "Headline", "style": "title.big", "animation": "slam", "slot": "hero", "at": 0.5, "beats": 2.5, "y": -0.2},
    {"chip": "ink", "text": "EVERYDAY BOTTLE", "label": "Product name", "style": "kicker.mono", "size": 36, "animation": "typewriter", "slot": "hero", "at": 0.75, "beats": 2.25, "y": -0.08},
    {"text": "Cold for 24 hours", "label": "Feature 1", "style": "caption.chip", "animation": "words", "inSeconds": 0.5, "outSeconds": 0.2, "slot": "feature-1", "at": 0.25, "y": -0.22},
    {"text": "Fits every cup holder", "label": "Feature 2", "style": "caption.chip", "animation": "words", "inSeconds": 0.5, "outSeconds": 0.2, "slot": "feature-2", "at": 0.25, "y": -0.22},
    {"text": "Five matte colors", "label": "Feature 3", "style": "caption.chip", "animation": "words", "inSeconds": 0.5, "outSeconds": 0.2, "slot": "feature-3", "at": 0.25, "y": -0.22},
    {"text": "$32", "label": "Price", "style": "number.huge", "animation": "slam", "slot": "end", "at": 0.5, "beats": 2.5, "y": -0.18},
    {"text": "AVAILABLE NOW", "label": "Call to action", "style": "label.gel", "size": 36, "animation": "typewriter", "slot": "end", "at": 0.75, "beats": 2.25, "y": -0.05}
  ],
  "sounds": [
    {"sound": "nowframe.sound.reverse-hit", "slot": "tease-3", "at": 0, "gain": 0.45},
    {"sound": "nowframe.sound.slam", "slot": "hero", "at": 0, "gain": 0.5},
    {"sound": "nowframe.sound.whoosh", "slot": "feature-1", "at": 0, "gain": 0.3}
  ]
}
