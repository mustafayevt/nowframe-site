{
  "$schema": "nowframe.template-spec/1",
  "id": "beat-photo-dump",
  "name": "Beat photo dump",
  "description": "A month of photos, one per beat: an opener with the title, a fast run of photos that punch in on the beat, a held last shot.",
  "category": "recap",
  "tags": ["beatsync", "photodump"],
  "pro": false,
  "canvas": "9:16",
  "bpm": 124,
  "flexible": true,
  "minAppBuild": 9,
  "accent": "tungsten",
  "look": { "filter": "nowframe.filter.vivid", "amount": 35, "grain": 6, "contrast": 4 },
  "music": { "track": "nowframe.music.play-house-dj", "start": "preview", "gain": 1, "fadeOut": 0.6 },
  "cover": { "from": "render", "background": "ink", "title": "Photo dump", "kicker": "One per beat" },
  "sections": [
    {
      "id": "intro",
      "slots": [
        { "id": "opener", "label": "Opener", "beats": 4, "min": 1.2, "max": 3.2, "sample": "city", "motion": "push",
          "cut": { "transition": "nowframe.transition.flash", "beats": 0.5 } }
      ]
    },
    {
      "id": "drop",
      "repeat": 12,
      "slots": [
        { "label": "Photo {n}", "beats": 1, "min": 0.3, "max": 1.2, "sample": "any", "prefers": "photo", "motion": "punch" }
      ]
    },
    {
      "id": "outro",
      "slots": [
        { "id": "last", "label": "Last one", "beats": 4, "hold": true, "sample": "nature", "motion": "pull" }
      ]
    }
  ],
  "beatEffects": [
    { "effect": "zoompulse", "anchor": "beat", "every": 2, "seconds": 0.2, "section": "drop" },
    { "effect": "flash", "anchor": "cut", "every": 4, "offset": 3, "seconds": 0.15, "section": "drop" }
  ],
  "texts": [
    { "text": "October\ndump", "label": "Title", "style": "title.big", "animation": "pop", "slot": "opener", "at": 0.5,
      "beats": 3.5, "y": -0.18 },
    { "text": "MY CAMERA ROLL", "label": "Subtitle", "style": "kicker.mono", "animation": "typewriter", "slot": "opener",
      "at": 1, "beats": 3, "y": 0.02 },
    { "text": "12 PHOTOS", "style": "label.gel", "animation": "cut", "slot": "Photo 1", "through": "Photo 12", "y": 0.27 },
    { "text": "See you next month", "label": "Sign-off", "style": "caption.medium", "animation": "words", "slot": "last",
      "at": 0.5, "y": 0.2 }
  ],
  "shapes": [
    { "shape": "ellipse", "color": "tally", "slot": "opener", "at": 0.5, "beats": 3.5, "x": 0, "y": -0.33, "scale": 0.05 }
  ],
  "sounds": [
    { "sound": "nowframe.sound.whoosh", "slot": "Photo 1", "at": 0, "gain": 0.35 }
  ]
}
