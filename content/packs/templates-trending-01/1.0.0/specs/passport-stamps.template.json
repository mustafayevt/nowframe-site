{
  "$schema": "nowframe.template-spec/1",
  "id": "passport-stamps",
  "name": "Passport stamps",
  "description": "A three-stop travel recap: a typed kicker and the destination over the arrival, then each stop opens with a numbered place chip, three cuts on the beat and a push with a swoosh into the next stop.",
  "category": "travel",
  "tags": ["beatsync", "travel"],
  "pro": false,
  "canvas": "9:16",
  "bpm": 112.1,
  "flexible": false,
  "minAppBuild": 9,
  "accent": "tungsten",
  "look": {"filter": "nowframe.filter.golden-hour", "amount": 35, "grain": 6},
  "music": {"track": "nowframe.music.mr-smith-pequenas-guitarras", "start": "preview", "gain": 1.0, "fadeOut": 0.6},
  "cover": {"from": "render", "background": "ink", "title": "Passport stamps", "kicker": "Three stops"},
  "sections": [
    { "id": "trip", "slots": [
        {"id": "arrival", "label": "Arrival", "beats": 4, "min": 1.17, "max": 4.29, "sample": "travel", "motion": "push"},
        {"id": "stop-1", "label": "Stop 1", "beats": 2, "min": 0.58, "max": 2.14, "sample": "city", "motion": "punch"},
        {"id": "stop-1-detail", "label": "Stop 1 detail", "beats": 2, "min": 0.58, "max": 2.14, "sample": "travel", "motion": "right"},
        {"id": "stop-1-quick", "label": "Stop 1 quick", "beats": 1, "min": 0.3, "max": 1.2, "sample": "food", "motion": "punch", "cut": {"transition": "nowframe.transition.push", "beats": 0.5}},
        {"id": "stop-2", "label": "Stop 2", "beats": 2, "min": 0.58, "max": 2.14, "sample": "nature", "motion": "punch"},
        {"id": "stop-2-detail", "label": "Stop 2 detail", "beats": 2, "min": 0.58, "max": 2.14, "sample": "travel", "motion": "left"},
        {"id": "stop-2-quick", "label": "Stop 2 quick", "beats": 1, "min": 0.3, "max": 1.2, "sample": "texture", "motion": "punch", "cut": {"transition": "nowframe.transition.push", "beats": 0.5}},
        {"id": "stop-3", "label": "Stop 3", "beats": 2, "min": 0.58, "max": 2.14, "sample": "water", "motion": "punch"},
        {"id": "stop-3-detail", "label": "Stop 3 detail", "beats": 2, "min": 0.58, "max": 2.14, "sample": "city", "motion": "right"},
        {"id": "stop-3-quick", "label": "Stop 3 quick", "beats": 1, "min": 0.3, "max": 1.2, "sample": "night", "motion": "punch"},
        {"id": "last-look", "label": "Last look", "beats": 4, "min": 1.17, "max": 4.29, "hold": true, "sample": "nature", "motion": "pull"}
      ] }
  ],
  "beatEffects": [
    {"effect": "zoompulse", "anchor": "beat", "every": 4, "seconds": 0.2, "from": "stop-1", "through": "stop-3-quick"}
  ],
  "texts": [
    {"text": "48 HOURS IN", "label": "Kicker", "style": "kicker.mono", "size": 36, "animation": "typewriter", "slot": "arrival", "at": 0.5, "beats": 3.5, "y": -0.31},
    {"text": "Portugal", "label": "Destination", "style": "title.big", "animation": "rise", "slot": "arrival", "at": 1, "beats": 3, "y": -0.23},
    {"text": "01 LISBON", "label": "Stop 1 name", "style": "label.gel", "size": 42, "animation": "typewriter", "slot": "stop-1", "through": "stop-1-quick", "y": -0.3},
    {"text": "02 SINTRA", "label": "Stop 2 name", "style": "label.gel", "size": 42, "animation": "typewriter", "slot": "stop-2", "through": "stop-2-quick", "y": -0.3},
    {"text": "03 PORTO", "label": "Stop 3 name", "style": "label.gel", "size": 42, "animation": "typewriter", "slot": "stop-3", "through": "stop-3-quick", "y": -0.3},
    {"text": "Until next time", "label": "Sign-off", "style": "quote.serif", "size": 60, "animation": "reveal", "slot": "last-look", "at": 0.5, "y": 0.16}
  ],
  "sounds": [
    {"sound": "nowframe.sound.swoosh", "slot": "stop-2", "at": 0, "gain": 0.3},
    {"sound": "nowframe.sound.swoosh", "slot": "stop-3", "at": 0, "gain": 0.3}
  ]
}
