{
  "$schema": "nowframe.template-spec/1",
  "id": "storytime-beats",
  "name": "Storytime on the beat",
  "description": "Storytime told one phrase per beat: big words slam in over mono footage and flat ink, tungsten and violet cards with a kick on each card, then a word-by-word cliffhanger.",
  "category": "text",
  "tags": ["beatsync", "text"],
  "pro": true,
  "canvas": "9:16",
  "bpm": 85.4,
  "flexible": false,
  "minAppBuild": 9,
  "accent": "iris",
  "look": {"filter": "nowframe.filter.mono-hi", "amount": 60, "contrast": 12, "brightness": -18},
  "music": {"track": "nowframe.music.holiznacc0-when-i-was-human", "start": "preview", "gain": 1.0, "fadeOut": 0.6},
  "cover": {"from": "render", "background": "ink", "title": "Storytime on the beat", "kicker": "One word a beat"},
  "sections": [
    { "id": "story", "slots": [
        {"id": "opener", "label": "Opener", "beats": 2, "min": 0.77, "max": 2.81, "sample": "city", "motion": "punch"},
        {"id": "card-1", "card": "ink", "beats": 1},
        {"id": "clip-2", "label": "Clip 2", "beats": 1, "min": 0.38, "max": 1.41, "sample": "home", "motion": "punch"},
        {"id": "clip-3", "label": "Clip 3", "beats": 1, "min": 0.38, "max": 1.41, "sample": "texture", "motion": "punch", "zoom": 1.05},
        {"id": "card-2", "card": "tungsten", "beats": 1},
        {"id": "clip-4", "label": "Clip 4", "beats": 1, "min": 0.38, "max": 1.41, "sample": "food", "motion": "punch"},
        {"id": "clip-5", "label": "Clip 5", "beats": 1, "min": 0.38, "max": 1.41, "sample": "home", "motion": "punch", "zoom": 1.05},
        {"id": "card-3", "card": "iris", "beats": 1},
        {"id": "clip-6", "label": "Clip 6", "beats": 1, "min": 0.38, "max": 1.41, "sample": "city", "motion": "punch"},
        {"id": "clip-7", "label": "Clip 7", "beats": 2, "min": 0.77, "max": 2.81, "sample": "night", "motion": "push"},
        {"id": "last", "label": "Last shot", "beats": 4, "min": 1.54, "max": 5.62, "hold": true, "sample": "nature", "motion": "pull"}
      ] }
  ],
  "beatEffects": [
    {"effect": "zoompulse", "anchor": "beat", "every": 2, "seconds": 0.12, "from": "clip-2", "through": "clip-7"}
  ],
  "texts": [
    {"text": "STORYTIME", "label": "Word 1", "style": "title.big", "animation": "slam", "size": 100, "slot": "opener", "y": -0.05},
    {"text": "PART 1", "label": "Part", "style": "kicker.mono", "size": 36, "animation": "typewriter", "slot": "opener", "at": 0.5, "y": 0.06},
    {"text": "So", "label": "Word 2", "style": "title.big", "animation": "slam", "slot": "card-1", "y": -0.05},
    {"text": "I quit", "label": "Word 3", "style": "title.big", "animation": "slam", "slot": "clip-2", "y": -0.05},
    {"text": "my job", "label": "Word 4", "style": "title.big", "animation": "slam", "slot": "clip-3", "y": -0.05},
    {"text": "to bake", "label": "Word 5", "style": "title.big", "animation": "slam", "color": "ink", "slot": "card-2", "y": -0.05},
    {"text": "bread", "label": "Word 6", "style": "title.big", "animation": "slam", "slot": "clip-4", "y": -0.05},
    {"text": "full time", "label": "Word 7", "style": "title.big", "animation": "slam", "size": 100, "slot": "clip-5", "y": -0.05},
    {"text": "Here's", "label": "Word 8", "style": "title.big", "animation": "slam", "color": "ink", "slot": "card-3", "y": -0.05},
    {"text": "how it", "label": "Word 9", "style": "title.big", "animation": "slam", "slot": "clip-6", "y": -0.05},
    {"text": "went", "label": "Word 10", "style": "title.big", "animation": "slam", "slot": "clip-7", "y": -0.05},
    {"text": "Part 2 if you want it", "label": "Cliffhanger", "style": "caption.chip", "animation": "words", "slot": "last", "at": 0.5, "y": -0.2}
  ],
  "sounds": [
    {"sound": "nowframe.sound.kick", "slot": "card-1", "at": 0, "gain": 0.35},
    {"sound": "nowframe.sound.kick", "slot": "card-2", "at": 0, "gain": 0.35},
    {"sound": "nowframe.sound.kick", "slot": "card-3", "at": 0, "gain": 0.35}
  ]
}
