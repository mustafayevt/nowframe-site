{
  "$schema": "nowframe.template-spec/1",
  "id": "month-in-numbers",
  "name": "Month in numbers",
  "description": "A monthly recap told in stats: a dark title card, then four huge numbers that slam in on the beat with a typed tungsten label and a snare, each over two quick clips, and a serif sign-off.",
  "category": "recap",
  "tags": ["beatsync", "recap", "text"],
  "pro": true,
  "canvas": "9:16",
  "bpm": 99.2,
  "flexible": false,
  "minAppBuild": 9,
  "accent": "tungsten",
  "look": {"filter": "nowframe.filter.teal-ember", "amount": 30, "grain": 6},
  "music": {"track": "nowframe.music.holiznacc0-make-funk", "start": "preview", "gain": 1.0, "fadeOut": 0.6},
  "cover": {"from": "render", "background": "ink", "title": "Month in numbers", "kicker": "By the numbers"},
  "sections": [
    { "id": "title", "slots": [
        {"id": "title-card", "card": "graphite", "beats": 3, "cut": {"transition": "nowframe.transition.flash", "beats": 0.25}}
      ] },
    { "id": "stats", "slots": [
        {"id": "stat-1", "label": "Stat 1", "beats": 2, "min": 0.66, "max": 2.42, "sample": "nature", "motion": "punch"},
        {"id": "stat-1-extra", "label": "Stat 1 extra", "beats": 1, "min": 0.33, "max": 1.21, "sample": "water", "motion": "push"},
        {"id": "stat-2", "label": "Stat 2", "beats": 2, "min": 0.66, "max": 2.42, "sample": "food", "motion": "punch"},
        {"id": "stat-2-extra", "label": "Stat 2 extra", "beats": 1, "min": 0.33, "max": 1.21, "sample": "home", "motion": "push"},
        {"id": "stat-3", "label": "Stat 3", "beats": 2, "min": 0.66, "max": 2.42, "sample": "city", "motion": "punch"},
        {"id": "stat-3-extra", "label": "Stat 3 extra", "beats": 1, "min": 0.33, "max": 1.21, "sample": "nature", "motion": "push"},
        {"id": "stat-4", "label": "Stat 4", "beats": 2, "min": 0.66, "max": 2.42, "sample": "travel", "motion": "punch"},
        {"id": "stat-4-extra", "label": "Stat 4 extra", "beats": 1, "min": 0.33, "max": 1.21, "sample": "texture", "motion": "push"}
      ] },
    { "id": "end", "slots": [
        {"id": "last", "label": "Last frame", "beats": 4, "min": 1.33, "max": 4.84, "hold": true, "sample": "night", "motion": "pull"}
      ] }
  ],
  "beatEffects": [
    {"effect": "zoompulse", "anchor": "beat", "every": 2, "offset": 1, "seconds": 0.15, "section": "stats"}
  ],
  "texts": [
    {"text": "This month,\nby the numbers", "label": "Title", "style": "title.display", "animation": "drop-words", "slot": "title-card", "at": 0.25, "beats": 2.5, "y": -0.06},
    {"text": "12", "label": "Number 1", "style": "number.huge", "animation": "slam", "slot": "stat-1", "through": "stat-1-extra", "y": -0.2},
    {"text": "SUNSETS", "label": "Label 1", "style": "label.gel", "size": 42, "animation": "typewriter", "slot": "stat-1", "at": 0.25, "through": "stat-1-extra", "y": -0.09},
    {"text": "4", "label": "Number 2", "style": "number.huge", "animation": "slam", "slot": "stat-2", "through": "stat-2-extra", "y": -0.2},
    {"text": "NEW RECIPES", "label": "Label 2", "style": "label.gel", "size": 42, "animation": "typewriter", "slot": "stat-2", "at": 0.25, "through": "stat-2-extra", "y": -0.09},
    {"text": "31", "label": "Number 3", "style": "number.huge", "animation": "slam", "slot": "stat-3", "through": "stat-3-extra", "y": -0.2},
    {"text": "MORNING WALKS", "label": "Label 3", "style": "label.gel", "size": 36, "animation": "typewriter", "slot": "stat-3", "at": 0.25, "through": "stat-3-extra", "y": -0.09},
    {"text": "1", "label": "Number 4", "style": "number.huge", "animation": "slam", "slot": "stat-4", "through": "stat-4-extra", "y": -0.2},
    {"text": "BIG DECISION", "label": "Label 4", "style": "label.gel", "size": 40, "animation": "typewriter", "slot": "stat-4", "at": 0.25, "through": "stat-4-extra", "y": -0.09},
    {"text": "Onto the next one", "label": "Sign-off", "style": "quote.serif", "size": 60, "animation": "reveal", "slot": "last", "at": 0.5, "y": 0.16}
  ],
  "sounds": [
    {"sound": "nowframe.sound.snare", "slot": "stat-1", "at": 0, "gain": 0.35},
    {"sound": "nowframe.sound.snare", "slot": "stat-2", "at": 0, "gain": 0.35},
    {"sound": "nowframe.sound.snare", "slot": "stat-3", "at": 0, "gain": 0.35},
    {"sound": "nowframe.sound.snare", "slot": "stat-4", "at": 0, "gain": 0.35}
  ]
}
