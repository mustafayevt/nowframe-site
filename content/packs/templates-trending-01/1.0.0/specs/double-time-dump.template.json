{
  "$schema": "nowframe.template-spec/1",
  "id": "double-time-dump",
  "name": "Double-time dump",
  "description": "A fast photo dump for a 150 BPM track: a title hit, nine photos in a 1-1-2 beat rhythm that punch in, a flash every third cut and a split hit on the bar, then a held last shot.",
  "category": "photodump",
  "tags": ["beatsync", "photodump"],
  "pro": true,
  "canvas": "9:16",
  "bpm": 151,
  "flexible": true,
  "minAppBuild": 9,
  "accent": "iris",
  "look": {"filter": "nowframe.filter.bleach", "amount": 35, "grain": 8, "contrast": 8},
  "music": {"track": "nowframe.music.holiznacc0-wolf", "start": "preview", "gain": 1.0, "fadeOut": 0.6},
  "cover": {"from": "render", "background": "ink", "title": "Double-time dump", "kicker": "Two photos a second"},
  "sections": [
    { "id": "intro", "slots": [
        {"id": "opener", "label": "Opener", "beats": 4, "min": 0.87, "max": 3.18, "sample": "city", "motion": "punch", "cut": {"transition": "nowframe.transition.quick-whip", "beats": 0.5}}
      ] },
    { "id": "drop", "repeat": 3, "slots": [
        {"label": "Photo {n}", "beats": 1, "min": 0.3, "max": 1.2, "sample": "any", "prefers": "photo", "motion": "punch"},
        {"label": "Photo {n}", "beats": 1, "min": 0.3, "max": 1.2, "sample": "any", "prefers": "photo", "motion": "push", "zoom": 1.06},
        {"label": "Photo {n}", "beats": 2, "min": 0.43, "max": 1.59, "sample": "any", "prefers": "photo", "motion": "punch", "zoom": 1.04}
      ] },
    { "id": "outro", "slots": [
        {"id": "last", "label": "Last one", "beats": 6, "min": 1.31, "max": 4.77, "hold": true, "sample": "night", "motion": "pull"}
      ] }
  ],
  "beatEffects": [
    {"effect": "zoompulse", "anchor": "beat", "every": 2, "seconds": 0.15, "section": "drop"},
    {"effect": "flash", "anchor": "cut", "every": 3, "offset": 2, "seconds": 0.12, "section": "drop"},
    {"effect": "channelsplit", "anchor": "beat", "every": 4, "offset": 3, "seconds": 0.2, "section": "drop"}
  ],
  "texts": [
    {"text": "CAMERA\nROLL", "label": "Title", "style": "title.big", "animation": "slam", "slot": "opener", "at": 0.5, "beats": 3.5, "y": -0.2},
    {"text": "VOL. 07", "label": "Volume", "style": "kicker.mono", "size": 36, "animation": "typewriter", "slot": "opener", "at": 1, "beats": 3, "y": -0.08},
    {"text": "That's the roll", "label": "Sign-off", "style": "caption.medium", "animation": "words", "slot": "last", "at": 1, "beats": 4, "y": 0.16}
  ],
  "sounds": [
    {"sound": "nowframe.sound.reverse-hit", "slot": "opener", "at": 2, "gain": 0.4}
  ]
}
